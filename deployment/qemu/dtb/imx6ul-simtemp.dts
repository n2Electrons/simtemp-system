/dts-v1/;

/ {
    model = "Freescale i.MX6UL SimTemp Development Board";
    compatible = "fsl,imx6ul-simtemp", "fsl,imx6ul";

    #address-cells = <1>;
    #size-cells = <1>;

    chosen {
        bootargs = "console=ttymxc0,115200 root=/dev/ram0 rw";
    };

    memory@80000000 {
        device_type = "memory";
        reg = <0x80000000 0x20000000>;
    };

    clocks {
        osc {
            compatible = "fixed-clock";
            #clock-cells = <0>;
            clock-frequency = <24000000>;
        };
    };

    soc {
        compatible = "simple-bus";
        #address-cells = <1>;
        #size-cells = <1>;
        ranges;

        aips1: aips-bus@02000000 {
            compatible = "fsl,aips-bus", "simple-bus";
            #address-cells = <1>;
            #size-cells = <1>;
            ranges = <0x02000000 0x02000000 0x100000>;

            uart1: serial@02020000 {
                compatible = "fsl,imx6ul-uart", "fsl,imx6q-uart";
                reg = <0x02020000 0x4000>;
                interrupts = <0 26 4>;
                status = "okay";
            };

            i2c1: i2c@021a0000 {
                compatible = "fsl,imx6ul-i2c", "fsl,imx21-i2c";
                reg = <0x021a0000 0x4000>;
                interrupts = <0 36 4>;
                #address-cells = <1>;
                #size-cells = <0>;
                status = "okay";

                /* Temperature sensor simulation node */
                simtemp_sensor: temperature-sensor@48 {
                    compatible = "simtemp,temperature-sensor";
                    reg = <0x48>;
                    status = "okay";
                    
                    /* Properties for F-K1-TC-002 testing */
                    temperature_range = <0xffd8 125>; /* -40 to 125 */
                    resolution = <12>;
                    sample_rate = <10>;
                    
                    /* GPIO pins for alerts/interrupts */
                    alert_gpios = <&gpio1 10 0>;
                    interrupt_parent = <&gpio1>;
                    interrupts = <10 2>;
                };
            };

            gpio1: gpio@0209c000 {
                compatible = "fsl,imx6ul-gpio", "fsl,imx35-gpio";
                reg = <0x0209c000 0x4000>;
                interrupts = <0 66 4>, <0 67 4>;
                gpio-controller;
                #gpio-cells = <2>;
                interrupt-controller;
                #interrupt-cells = <2>;
            };
        };
    };
};