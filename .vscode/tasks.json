{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Docker Container",
            "type": "shell",
            "command": "docker-compose",
            "args": [
                "build"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Build the temperature sensor driver Docker container"
        },
        {
            "label": "Start Docker Container",
            "type": "shell",
            "command": "docker-compose",
            "args": [
                "up",
                "-d"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Start the temperature sensor driver container in detached mode"
        },
        {
            "label": "Stop Docker Container",
            "type": "shell",
            "command": "docker-compose",
            "args": [
                "down"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Stop and remove the temperature sensor driver container"
        },
        {
            "label": "Run CLI Application",
            "type": "shell",
            "command": "python",
            "args": [
                "user/cli/main.py",
                "--help"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Run the temperature sensor CLI application"
        },
        {
            "label": "Run CLI - Test Mode",
            "type": "shell",
            "command": "python",
            "args": [
                "user/cli/main.py",
                "--test-mode",
                "--count",
                "10"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Run CLI application in test mode with 10 sample readings"
        },
        {
            "label": "Run GUI Application",
            "type": "shell",
            "command": "python",
            "args": [
                "user/gui/main.py"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Launch the temperature sensor GUI application"
        },
        {
            "label": "Install Python Dependencies",
            "type": "shell",
            "command": "pip",
            "args": [
                "install",
                "-r",
                "user/gui/requirements.txt"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Install Python dependencies for the GUI application"
        },
        {
            "label": "Run Octave - Threshold Analyzer",
            "type": "shell",
            "command": "octave",
            "args": [
                "--eval",
                "addpath('octave-modules/cli-processing-modules'); threshold_analyzer('data/temp_readings/sample.csv', 75.0, 10.0)"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Run Octave threshold analysis on sample data"
        },
        {
            "label": "Format Python Code",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "black",
                "user/"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Format Python code using Black formatter"
        },
        {
            "label": "Lint Python Code",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "flake8",
                "user/"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Run flake8 linter on Python code"
        },
        {
            "label": "Docker Container Logs",
            "type": "shell",
            "command": "docker-compose",
            "args": [
                "logs",
                "-f"
            ],
            "group": "test",
            "isBackground": true,
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Follow Docker container logs in real-time"
        },
        {
            "label": "Clean Build Artifacts",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "Remove-Item -Recurse -Force -ErrorAction SilentlyContinue user/**/__pycache__, user/**/*.pyc, data/logs/*.log, data/exports/*.csv"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Clean Python cache files and temporary data"
        },
        {
            "label": "Full System Test",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "Write-Host 'Starting full system test...'; python user/cli/main.py --test-mode --count 5; Write-Host 'CLI test completed.'"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Run comprehensive system test including CLI and validation"
        },
        {
            "label": "Generate Documentation",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pydoc",
                "-w",
                "user.cli.main",
                "user.gui.main"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Generate HTML documentation for Python modules"
        }
    ]
}