    "compounds": [
        {
            "name": "Debug Full System",
            "configurations": [
                "Debug CLI - Test Mode"
            ],
            "stopAll": true,
            "presentation": {
                "hidden": false,
                "group": "system",
                "order": 1
            }
        }
    ]
