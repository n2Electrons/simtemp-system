{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug CLI Application",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/user/cli/main.py",
            "args": [
                "--help"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {},
            "envFile": "${workspaceFolder}/.env",
            "python": "${command:python.interpreterPath}",
            "justMyCode": true,
            "stopOnEntry": false,
            "showReturnValue": true
        },
        {
            "name": "Debug CLI - Test Mode",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/user/cli/main.py",
            "args": [
                "--test-mode",
                "--count",
                "5",
                "--verbose"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {},
            "envFile": "${workspaceFolder}/.env",
            "python": "${command:python.interpreterPath}",
            "justMyCode": true,
            "stopOnEntry": false,
            "showReturnValue": true
        },
        {
            "name": "Debug CLI - Device Configuration",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/user/cli/main.py",
            "args": [
                "configure",
                "--sampling-rate",
                "1000",
                "--high-threshold",
                "75.0",
                "--low-threshold",
                "10.0"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {},
            "envFile": "${workspaceFolder}/.env",
            "python": "${command:python.interpreterPath}",
            "justMyCode": true,
            "stopOnEntry": false,
            "showReturnValue": true
        },
        {
            "name": "Debug CLI - Read Temperature",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/user/cli/main.py",
            "args": [
                "read",
                "--count",
                "10",
                "--output",
                "data/exports/debug_readings.csv"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {},
            "envFile": "${workspaceFolder}/.env",
            "python": "${command:python.interpreterPath}",
            "justMyCode": true,
            "stopOnEntry": false,
            "showReturnValue": true
